# MALLYA — environment template. DEV / DEMO VALUES ONLY. No real secrets belong here.
# `python tools/gen_env.py` (or `make install` / `./mallya.ps1 install`) writes a .env with fresh random secrets.

APP_ENV=development
DEMO_MODE=true
SEED=42

# Control-plane database (MALLYA) and customer-side database (Meridian Bank sandbox)
DATABASE_URL=postgresql+psycopg://mallya_app:change-me@postgres:5432/mallya
REDIS_URL=redis://redis:6379/0
POSTGRES_PASSWORD=change-me
MALLYA_DB_PASSWORD=change-me
MERIDIAN_DB_PASSWORD=change-me

# LLM provider abstraction. "local" = deterministic reasoning templates; no API key needed.
LLM_PROVIDER=local
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Sandbox object storage (MinIO root account — used only by the customer-side worker's sandbox controller)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me-at-least-8
MINIO_AUDIT_TOKEN=change-me
SANDBOX_SERVICE_PASSWORD=change-me-at-least-8

# Control-plane secrets
SECRET_KEY=change-me
# HMAC key for record fingerprints. Separate from every other secret. Never stored in the DB.
FINGERPRINT_KEY=change-me
# Ed25519 evidence signing key file (generated inside the backend's secrets volume; never in git)
EVIDENCE_SIGNING_KEY_PATH=/run/mallya-secrets/evidence_signing_key.pem
# Backend -> worker approval tokens (worker refuses remediation without a valid human approval token)
APPROVAL_SIGNING_KEY=change-me

# Service-to-service tokens inside the sandbox
WORKER_TOKEN=change-me
PROBE_TOKEN=change-me
CDN_ADMIN_TOKEN=change-me
MOCK_IAM_TOKEN=change-me
MOCK_VENDOR_TOKEN=change-me

# Host port for the web UI (3000 is often taken)
FRONTEND_PORT=3100
